            "format": "int64",
            "type": "integer"
          },
          "report": {
            "$ref": "#/components/schemas/DeviceReport"
          }
        },
        "required": [
          "report",
          "received"
        ],
        "type": "object"
      },
      "DeviceTool": {
        "additionalProperties": true,
        "properties": {
          "command": {
            "description": "The command that read it: doctor, device, device-watch, awake.",
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "name": {
            "description": "The program: claude-rig, irgo-winvm.",
            "maxLength": 200,
            "type": "string"
          },
          "version": {
            "description": "Its version, or the commit it runs.",
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "version",
          "command"
        ],
        "type": "object"
      },
      "DeviceView": {
        "additionalProperties": false,
        "properties": {
          "conditions": {
            "description": "Empty when there is nothing to say.",
            "items": {
              "$ref": "#/components/schemas/DeviceCondition"
            },
            "type": "array"
          },
          "due": {
            "description": "When the next was promised by: received + next_s. Absent when none was.",
            "format": "int64",
            "type": "integer"
          },
          "received": {
            "description": "When the Worker received it, Unix milliseconds.",
            "format": "int64",
            "type": "integer"
          },
          "report": {
