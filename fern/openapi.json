          },
          "cpu": {
            "$ref": "#/components/schemas/DeviceCPU"
          },
          "disks": {
            "description": "The system volume and the volume the tool keeps its data on; one entry with both roles when they are the same volume.",
            "items": {
              "$ref": "#/components/schemas/DeviceDisk"
            },
            "maxItems": 8,
            "minItems": 1,
            "type": "array"
          },
          "host": {
            "$ref": "#/components/schemas/DeviceHost"
          },
          "id": {
            "description": "The machine id: 16 random hex digits made once per machine. Derived from nothing about the machine.",
