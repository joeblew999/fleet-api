          },
          "schema": {
            "description": "The report's schema number; 1 today. The Worker refuses one it does not know.",
            "format": "int32",
            "minimum": 1,
            "type": "integer"
          },
          "sleep": {
            "$ref": "#/components/schemas/DeviceSleep"
          },
          "tool": {
            "$ref": "#/components/schemas/DeviceTool"
          },
          "ts": {
            "description": "When the device read this, by its own clock, Unix milliseconds. Lateness is judged by when the Worker received it, never by this.",
            "format": "int64",
            "minimum": 1,
            "type": "integer"
          }
        },
        "required": [
          "schema",
          "id",
          "ts",
          "reason",
          "next_s",
          "tool",
          "host",
          "cpu",
          "memory",
          "disks",
          "power",
          "battery",
          "lid",
          "sleep",
