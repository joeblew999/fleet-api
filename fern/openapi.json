      },
      "DeviceRig": {
        "additionalProperties": true,
        "properties": {
          "claude_version": {
            "description": "What claude --version prints; absent when Claude is not installed.",
            "maxLength": 200,
            "type": "string"
          },
          "commit": {
            "description": "The claude-rig commit it last ran; absent when not known.",
            "maxLength": 64,
            "type": "string"
          },
          "config_applied": {
            "description": "The rig's Claude configuration is applied.",
            "type": "boolean"
          },
          "logged_in": {
            "description": "Claude is logged in.",
            "type": "boolean"
          },
          "session_running": {
            "description": "A Claude session is running for the rig.",
            "type": "boolean"
          },
          "status": {
            "description": "none: claude-rig never set this machine up.",
            "enum": [
              "ok",
              "none",
              "unknown"
            ],
            "type": "string"
          },
          "tools_installed": {
            "description": "Every tool the rig installs is there.",
            "type": "boolean"
          },
          "why": {
            "maxLength": 200,
            "type": "string"
          },
          "work_dir": {
            "description": "Where its jobs run, the home directory written as ~.",
            "maxLength": 200,
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "type": "object"
      },
      "DeviceSleep": {
        "additionalProperties": true,
        "properties": {
          "display_s": {
            "description": "Idle seconds before the display turns off; 0 is never.",
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "idle_s": {
            "description": "Idle seconds before it sleeps on the current power source; 0 is never.",
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "inhibited": {
            "description": "Something is holding idle sleep off right now.",
            "type": "boolean"
          },
          "inhibitors": {
            "description": "The programs holding it off, by process name only.",
            "items": {
              "maxLength": 200,
              "type": "string"
            },
            "maxItems": 8,
            "type": "array"
          },
          "lid_action": {
            "description": "What closing the lid does now. nothing is a machine that keeps running closed.",
            "enum": [
              "sleep",
              "hibernate",
              "shutdown",
              "lock",
              "nothing"
            ],
            "type": "string"
          },
          "status": {
            "description": "none: a machine that cannot sleep (a container, a CI runner).",
            "enum": [
              "ok",
              "none",
              "unknown"
            ],
            "type": "string"
          },
          "why": {
            "maxLength": 200,
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "type": "object"
      },
      "DeviceStored": {
        "additionalProperties": false,
