            "description": "The device promises its next report within this many seconds; 0 promises none (reason stop or once).",
            "format": "int64",
            "maximum": 86400,
            "minimum": 0,
            "type": "integer"
          },
          "power": {
            "$ref": "#/components/schemas/DevicePower"
          },
          "reason": {
            "description": "Why it was sent.",
            "enum": [
              "start",
              "change",
              "interval",
              "stop",
              "once"
            ],
            "type": "string"
          },
          "rig": {
            "$ref": "#/components/schemas/DeviceRig",
