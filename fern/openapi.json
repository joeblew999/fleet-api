{
  "components": {
    "schemas": {
      "DeviceBattery": {
        "additionalProperties": true,
        "properties": {
          "count": {
            "format": "int32",
            "minimum": 1,
            "type": "integer"
          },
          "health": {
            "description": "Full capacity as a percent of design capacity; absent when the OS does not say.",
            "format": "double",
            "maximum": 150,
            "minimum": 0,
            "type": "number"
          },
          "percent": {
            "description": "Charge, as the OS shows it.",
            "format": "double",
            "maximum": 100,
            "minimum": 0,
            "type": "number"
          },
          "remaining_s": {
            "description": "The OS's estimate to empty or to full, seconds; absent when it has none.",
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "state": {
            "description": "idle: on external power, neither charging nor full (a charge limit).",
            "enum": [
              "charging",
              "discharging",
              "full",
              "idle"
            ],
            "type": "string"
          },
          "status": {
            "enum": [
              "ok",
              "none",
              "unknown"
            ],
            "type": "string"
          },
          "why": {
            "maxLength": 200,
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "type": "object"
      },
      "DeviceCPU": {
        "additionalProperties": true,
        "properties": {
          "count": {
            "description": "Logical processors.",
            "format": "int32",
            "minimum": 1,
            "type": "integer"
          },
          "load1": {
            "description": "The one-minute load average; absent on Windows, which has none.",
            "format": "double",
            "minimum": 0,
            "type": "number"
          },
          "status": {
            "enum": [
              "ok",
              "unknown"
            ],
            "type": "string"
          },
          "why": {
            "maxLength": 200,
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "type": "object"
      },
      "DeviceClaim": {
        "additionalProperties": true,
        "properties": {
          "caller": {
            "description": "Who holds it: an agent, a session or a tool. Never a person's user name or address, so no @.",
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "id": {
            "description": "The claim's id on the machine.",
            "pattern": "^[A-Za-z0-9._-]{1,64}$",
            "type": "string"
          },
          "job": {
            "description": "What it is doing.",
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "since": {
            "description": "When it was taken, Unix milliseconds, by the machine's clock.",
            "format": "int64",
            "minimum": 1,
            "type": "integer"
          },
          "until": {
            "description": "When it lapses unless renewed, Unix milliseconds; absent when it does not lapse.",
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "id",
          "caller",
          "job",
          "since"
        ],
        "type": "object"
      },
      "DeviceClaims": {
        "additionalProperties": true,
        "properties": {
          "held": {
            "description": "The claims held now; empty or absent when the machine is free.",
            "items": {
              "$ref": "#/components/schemas/DeviceClaim"
            },
            "maxItems": 64,
            "type": "array"
          },
          "slots": {
            "description": "How many jobs it takes at once.",
            "format": "int32",
            "maximum": 64,
            "minimum": 1,
            "type": "integer"
          },
          "status": {
            "description": "none: this machine takes no claims.",
            "enum": [
              "ok",
              "none",
              "unknown"
            ],
            "type": "string"
          },
          "why": {
            "maxLength": 200,
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "type": "object"
      },
      "DeviceCondition": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "enum": [
              "stopped",
              "quiet",
              "unminded",
              "closed-on-battery",
              "battery-low",
              "rig-unready"
            ],
            "type": "string"
          },
          "since": {
            "description": "When it began to hold, as far as the Worker knows: when the report that shows it was received, or for quiet when the report became late. Unix milliseconds.",
            "format": "int64",
            "type": "integer"
          },
          "why": {
            "description": "One sentence, with the numbers.",
            "type": "string"
          }
        },
        "required": [
          "code",
          "since",
          "why"
        ],
        "type": "object"
      },
      "DeviceDisk": {
        "additionalProperties": true,
        "properties": {
          "free": {
            "description": "What this user can still write.",
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "fs": {
            "description": "apfs, ext4, NTFS.",
            "maxLength": 200,
            "type": "string"
          },
          "path": {
            "description": "Where it is mounted, the home directory written as ~.",
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "roles": {
            "description": "system: the OS's volume. data: where the tool keeps its work.",
            "items": {
              "enum": [
                "system",
                "data"
              ],
              "type": "string"
            },
            "maxItems": 2,
            "minItems": 1,
            "type": "array"
          },
          "status": {
            "enum": [
              "ok",
              "unknown"
            ],
            "type": "string"
          },
          "total": {
            "format": "int64",
            "minimum": 1,
            "type": "integer"
          },
          "why": {
            "maxLength": 200,
            "type": "string"
          }
        },
        "required": [
          "roles",
          "path",
          "status"
        ],
        "type": "object"
      },
      "DeviceHistory": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "reports": {
            "items": {
              "$ref": "#/components/schemas/DeviceStored"
            },
            "type": "array"
          }
        },
        "required": [
          "id",
          "reports"
        ],
        "type": "object"
      },
      "DeviceHost": {
        "additionalProperties": true,
        "properties": {
          "arch": {
            "description": "GOARCH: arm64, amd64.",
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "boot": {
            "description": "When it booted, Unix milliseconds.",
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "guest": {
            "description": "True in a virtual machine; absent when that cannot be told.",
            "type": "boolean"
          },
          "model": {
            "description": "The hardware model, Mac14,10. Never a serial number.",
            "maxLength": 200,
            "type": "string"
          },
          "name": {
            "description": "The hostname's first label.",
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "os": {
            "description": "GOOS.",
            "enum": [
              "darwin",
              "linux",
              "windows"
            ],
            "type": "string"
          },
          "os_name": {
            "description": "macOS, Ubuntu, Windows 11 Pro.",
            "maxLength": 200,
            "type": "string"
          },
          "os_version": {
            "maxLength": 200,
            "type": "string"
          }
        },
        "required": [
          "name",
          "os",
          "arch"
        ],
        "type": "object"
      },
      "DeviceKeeper": {
        "additionalProperties": true,
        "properties": {
          "idle": {
            "description": "It is holding idle sleep off.",
            "type": "boolean"
          },
          "lid": {
            "description": "It has set closing the lid to do nothing.",
            "type": "boolean"
          },
          "running": {
            "type": "boolean"
          },
          "status": {
            "description": "none: the tool has no keep-awake for this OS.",
            "enum": [
              "ok",
              "none",
              "unknown"
            ],
            "type": "string"
          },
          "why": {
            "maxLength": 200,
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "type": "object"
      },
      "DeviceLid": {
        "additionalProperties": true,
        "properties": {
          "closed": {
            "type": "boolean"
          },
          "status": {
            "enum": [
              "ok",
              "none",
              "unknown"
            ],
            "type": "string"
          },
          "why": {
            "maxLength": 200,
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "type": "object"
      },
      "DeviceList": {
        "additionalProperties": false,
        "properties": {
          "devices": {
            "description": "By id.",
            "items": {
              "$ref": "#/components/schemas/DeviceView"
            },
            "type": "array"
          },
          "now": {
            "description": "The Worker's clock, Unix milliseconds: what due and quiet are judged against.",
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "now",
          "devices"
        ],
        "type": "object"
      },
      "DeviceMemory": {
        "additionalProperties": true,
        "properties": {
          "available": {
            "description": "What a new program could have without swapping.",
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "status": {
            "enum": [
              "ok",
              "unknown"
            ],
            "type": "string"
          },
          "total": {
            "format": "int64",
            "minimum": 1,
            "type": "integer"
          },
          "why": {
            "maxLength": 200,
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "type": "object"
      },
      "DevicePosted": {
        "additionalProperties": false,
        "properties": {
          "conditions": {
            "items": {
              "$ref": "#/components/schemas/DeviceCondition"
            },
            "type": "array"
          },
          "duplicate": {
            "description": "This id and ts were already stored; nothing changed.",
            "type": "boolean"
          },
          "id": {
            "type": "string"
          },
          "received": {
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "id",
          "received",
          "duplicate",
          "conditions"
        ],
        "type": "object"
      },
      "DevicePower": {
        "additionalProperties": true,
        "properties": {
          "source": {
            "enum": [
              "ac",
              "battery",
              "ups"
            ],
            "type": "string"
          },
          "status": {
            "enum": [
              "ok",
              "unknown"
            ],
            "type": "string"
          },
          "why": {
            "maxLength": 200,
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "type": "object"
      },
      "DeviceReport": {
        "additionalProperties": true,
